   <string notr="true">QDialog {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #0a1628,
        stop: 0.5 #142240,
        stop: 1 #0d1f3c
    );
    border-radius: 16px;
   /* Border Biru Kaca Halus agar tegas berpisah dari background */
    border: 1px solid rgba(2, 119, 230, 0.35);
}
/* HILANGKAN SEMUA BORDER FRAME SECARA MUTLAK */
QFrame {
    border: none;
    background: transparent;
}
QFrame#titlebar {
    background: rgba(2, 72, 193, 0.12);
    border: none;
    border-bottom: 1px solid rgba(248, 214, 19, 0.15);
 
}

QLabel#label_3 {
    color: #f8d613;
    font-family: Plus Jakarta Sans;
    font-size: 11px;
    font-weight: 600;
    background: transparent;
    border: none;
}

QPushButton#btn_close {
    background: rgba(255, 255, 255, 0.03);
    border: none;
    border-radius: 6px;
}

QPushButton#btn_close:hover {
    background: rgba(255, 70, 70, 0.25);
}

QFrame#frame_messageBox {
    background: rgba(255, 255, 255, 0.04);
}

QLabel#label, QLabel#label_2 {
    color: rgba(255, 255, 255, 0.50);
    font-family: Poppins;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    background: transparent;
    border: none;
}

QLabel#lbNrpRF, QLabel#lbFingerR {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    color: #ffffff;
    font-family: Poppins;
    font-size: 14px;
    font-weight: 500;
    padding: 6px 10px;
    min-height: 28px;
}

QLabel#lbIconF {
    background-color: #0248c1;
    border: 1px solid rgba(2,72,193, 0.2);
    border-radius: 12px;
    padding: 8px;
}

QLabel#lbInfoF {
    color: #ffffff;
    font-family: Inter;
    font-size: 20px;
    font-weight: 500;
    background: transparent;
    border: none;
}

QLabel#lbInfoF span {
    color: #f8d613;
}

QFrame#frame_button {
    background: rgba(255, 255, 255, 0.02);
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 0 0 16px 16px;
}


QScrollBar:vertical {
    background: rgba(255, 255, 255, 0.02);
    border: none;
    border-radius: 8px;
    width: 4px;
}

QScrollBar::handle:vertical {
    background: rgba(248, 214, 19, 0.25);
    border-radius: 8px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(248, 214, 19, 0.40);
}</string>
