     <property name="styleSheet">
      <string notr="true">QTableWidget {
    background-color: rgba(10, 22, 42, 0.50); /* Kaca Biru gelap transparan */
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    color: #e6f0ff;
    gridline-color: transparent;
    outline: none;
}

/* Header Tabel Glassmorphism */
QHeaderView::section {
    background-color: rgba(2, 72, 193, 0.30);
	color: rgb(26, 51, 74);
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 700;
    padding: 5px;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

/* Item / Baris Tabel */
QTableWidget::item {
    padding: 10px 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03); /* Divider halus antar baris */
    background: transparent;
}

/* Hover Effect saat Mouse di Atas Baris */
QTableWidget::item:hover {
    background-color: rgba(2, 119, 230, 0.18);
    color: #ffffff;
}
/* Tampilan Baris yang Sedang Dipilih (Selected) */
QTableWidget::item:selected {
    background-color: rgba(2, 72, 193, 0.60);
    color: #FFF701; /* Highlight text kuning khas UI kamu */
    font-weight: 600;
}

/* 1. Ubah background nomor baris (Vertical Header) jadi transparan */
QHeaderView::section:vertical {
    background-color: transparent;
    color: rgba(255, 255, 255, 0.6);
    border: none;
    padding-left: 5px;
}

/* 2. Ubah warna kotak di pojok kiri atas (pertemuan header atas &amp; kiri) */
QTableCornerButton::section {
    background-color: transparent;
    border: none;
}</string>
