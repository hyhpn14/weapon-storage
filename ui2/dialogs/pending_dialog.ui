   <string notr="true">QDialog {
    /* Gradasi Biru Gelap Presisi (Midnight Deep Blue) */
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #0d192e,
        stop: 0.5 #11223e,
        stop: 1 #0a1324
    );
    border-radius: 20px;
    /* Border Biru Kaca Halus agar tegas berpisah dari background */
    border: 1px solid rgba(2, 119, 230, 0.35);
}

QLabel#titleLabel {
    color: #ffffff;
    font-family: Plus Jakarta Sans;
    font-size: 22px;
    font-weight: 700;
    background: transparent;
    border: none;
    letter-spacing: 1px;
}

QLabel#subtitleLabel {
    color: rgba(255, 255, 255, 0.50);
    font-family: Inter;
    font-size: 13px;
    font-weight: 400;
    background: transparent;
    border: none;
}

QHeaderView::section {
    background: rgba(2, 72, 193, 0.15);
    color: #ffffff;
    font-family: Inter;
    font-size: 12px;
    font-weight: 600;
    padding: 10px 14px;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

QPushButton {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 12px;
    color: rgba(255, 255, 255, 0.80);
    font-family: Inter;
    font-size: 14px;
    font-weight: 500;
    padding: 10px 20px;
    min-height: 20px;
}

QPushButton:hover {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.20);
}

QPushButton#btnEnroll {
    background: #f8d613;
    border: none;
    color: #0d1a30;
    font-weight: 700;
}

QPushButton#btnEnroll:hover {
    background: #ffe44d;
}

QPushButton#btnEnroll:pressed {
    background: #d4b800;
}

QPushButton#btnClose {
    background: rgba(255, 255, 255, 0.03);
    border: none;
    border-radius: 8px;
}

QPushButton#btnClose:hover {
    background: rgba(255, 70, 70, 0.15);
}

QPushButton#btnRefresh {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.10);
}

QPushButton#btnRefresh:hover {
    background: rgba(2, 72, 193, 0.15);
    border: 1px solid #0248c1;
}

QScrollBar:vertical {
    background: rgba(255, 255, 255, 0.02);
    border: none;
    border-radius: 8px;
    width: 4px;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.10);
    border-radius: 8px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(248, 214, 19, 0.20);
}
</string>
