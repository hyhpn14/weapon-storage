    border: 1px solid rgba(2, 119, 230, 0.35);
}
/* HILANGKAN SEMUA BORDER FRAME SECARA MUTLAK */
QFrame {
    border: none;
    background: transparent;
}

QFrame#titlebar {
    background: rgba(2, 72, 193, 0.12);
    border: none;
    border-bottom: 1px solid rgba(248, 214, 19, 0.15);
    border-radius: 16px 16px 0 0;
}

QLabel#lbTitle {
    color: #f8d613;
    font-family: Plus Jakarta Sans;
    font-size: 11px;
    font-weight: 600;
    background: transparent;
    border: none;
}

QPushButton#btn_close {
    background: rgba(255, 255, 255, 0.03);
    border: none;
    border-radius: 6px;
}

QPushButton#btn_close:hover {
    background: rgba(255, 70, 70, 0.25);
}

QFrame#frame_messageBox {
    background: rgba(255, 255, 255, 0.02);
}

QLabel#lbIcon {
    background-color: rgba(2, 72, 193, 0.2);
    border: 1px solid rgba(2, 72, 193, 0.4);
    border-radius: 12px;
    padding: 8px;
}

QLabel#lbMessage {
    color: #ffffff;
    font-family: Inter;
    font-size: 13px;
    font-weight: 500;
    background: transparent;
    border: none;
}

QFrame#frame_button {
    background: rgba(255, 255, 255, 0.02);
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 0 0 16px 16px;
}

QPushButton#btnOk {
    background: rgba(2, 72, 193, 0.30);
    border: 1px solid #0248c1;
    border-radius: 8px;
    color: #ffffff;
    font-family: Inter;
    font-size: 12px;
    font-weight: 600;
    padding: 5px 20px;
    min-height: 20px;
}

QPushButton#btnOk:hover {
    background: #0248c1;
}

QPushButton#btnCancel {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: rgba(255, 255, 255, 0.70);
    font-family: Inter;
    font-size: 12px;
    font-weight: 500;
    padding: 5px 20px;
    min-height: 20px;
}

QPushButton#btnCancel:hover {
    background: rgba(255, 70, 70, 0.2);
    border: 1px solid rgba(255, 70, 70, 0.4);
    color: #ffffff;
}</string>
