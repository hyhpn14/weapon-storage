   <string notr="true">QDialog {
    background: transparent;
}

QFrame#containerFrame {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #0a1628,
        stop: 0.5 #142240,
        stop: 1 #0d1f3c
