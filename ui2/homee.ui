                  <property name="styleSheet">
                   <string notr="true">QPushButton {
    /* Mengatur teks tombol di kiri atas */
    text-align: left top;
    padding-left: 15px;
    padding-top: 5px;
    
    /* Font style untuk teks posisi */
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    font-weight: bold;
    color: rgba(255, 255, 255, 0.4); /* Mengikuti warna samar 'A1' pada desain */

    /* Mengatur latar belakang tombol dengan Icon yang kamu punya */
    background-image: url(&quot;C:/Users/programmer/Documents/06. Project 2026/08. Gun storage/scr/assets/state/glock/lock/gl-full-lock.png&quot;);
    background-position: center;
    background-repeat: no-repeat;
    background-color: rgba(255, 255, 255, 0.03);
    border: 2px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
}
QPushButton:hover {
    background-color: rgba(16, 185, 129, 0.15);
    border: 2px solid rgba(16, 185, 129, 0.30);
}
QPushButton:pressed {
    background-color: rgba(16, 185, 129, 0.30);
    border: 2px solid rgba(16, 185, 129, 0.50);
}</string>
