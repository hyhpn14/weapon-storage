  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #0a1628,
        stop: 0.4 #142240,
        stop: 0.7 #1a2a4a,
        stop: 1 #0d1f3c
    );
}

QFrame#frame {
    background: rgba(255, 255, 255, 0.04);
    border-radius: 30px;
    border: none;
}

QFrame#frame_header {
    background: rgba(255, 255, 255, 0.02);
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
   
}

QLabel#labelTitle {
    color: #ffffff;
    font-family: Plus Jakarta Sans;
    font-size: 20px;
    font-weight: 700;
    background: transparent;
    border: none;
    letter-spacing: 2px;
}

QLabel#labelForm {
    color: rgba(255, 255, 255, 0.70);
    font-family: Inter;
    font-size: 13px;
    font-weight: 600;
    background: transparent;
    border: none;
}

QLineEdit {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 8px 12px;
    color: #ffffff;
    font-family: Inter;
    font-size: 13px;
    min-height: 32px;
}

QLineEdit:focus {
	border: 1px solid #FFF701;
    
    background: rgba(2, 72, 193, 0.08);
}

QComboBox {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 8px 12px;
    color: #ffffff;
    font-family: Inter;
    font-size: 13px;
    min-height: 32px;
}

QComboBox:focus {
    border: 1px solid #FFF701;
}

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QComboBox::down-arrow {
    image: url(../assets/down.png);
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: #0d1a30;
    color: white;
    selection-background-color: #0248c1;
    selection-color: white;
    border: 1px solid rgba(255,255,255,0.08);
}

QPushButton#btReset, QPushButton#btBack {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    color: rgba(255, 255, 255, 0.70);
    font-family: Inter;
    font-size: 13px;
    font-weight: 500;
    padding: 8px 20px;
    min-height: 32px;
}

QPushButton#btReset:hover, QPushButton#btBack:hover {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.20);
}


QFrame#frame_status {
    background: rgba(255, 255, 255, 0.02);
    border-radius: 0 0 30px 30px;
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
}

QLabel#statusLabel {
    color: #10b981;
    font-family: Inter;
    font-size: 12px;
    font-weight: 500;
    background: transparent;
    border: none;
}

QLabel#labelVersion {
    color: #f8d613;
    font-family: Inter;
    font-size: 11px;
    font-weight: 400;
    background: transparent;
    border: none;
}

QScrollBar:vertical {
    background: rgba(255, 255, 255, 0.02);
    border: none;
    border-radius: 8px;
    width: 4px;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(248, 214, 19, 0.20);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
</string>
