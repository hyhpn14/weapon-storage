  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #0a1628,
        stop: 0.4 #142240,
        stop: 0.7 #1a2a4a,
        stop: 1 #0d1f3c
    );
}

QFrame#frame {
    background: rgba(255, 255, 255, 0.04);
    border-radius: 30px;
    border: none;
}

QFrame#frame_3 {
    background: rgba(255, 255, 255, 0.02);
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

QLabel#label {
    color: #ffffff;
    font-family: Plus Jakarta Sans;
    font-size: 22px;
    font-weight: 700;
    background: transparent;
    border: none;
    letter-spacing: 3px;
}

/* JAM - Space Grotesk */
QLabel#lbTime {
    color: rgba(255, 255, 255, 0.90);
    font-family: Space Grotesk;
    font-size: 100px;
    font-weight: 700;
    background: transparent;
    border: none;
    letter-spacing: 6px;
}

/* TANGGAL - Inter */
QLabel#lbDate {
    color: rgba(255, 255, 255, 0.60);
    font-family: Inter;
    font-size: 16px;
    font-weight: 400;
    background: transparent;
    border: none;
    letter-spacing: 1px;
}

/* LOGO */
QLabel#labelLogo {
    background: transparent;
    border: none;
}

/* TOMBOL ENTER - Glass Style */
/* Normal: border tipis transparan */
QPushButton#btDown {
    background: rgba(255, 255, 255, 0.03);
   
    border-radius: 30px;
}

/* Hover: border lebih terang + glow biru */
QPushButton#btDown:hover {
    background: rgba(2, 72, 193, 0.12);
    border: 1px solid #0248c1;
    box-shadow: 0 0 20px rgba(2, 72, 193, 0.2); /* efek glow (kalo support) */
}

QPushButton#btDown:pressed {
    background: rgba(2, 72, 193, 0.25);
    border: 2px solid #0248c1;
}

/* STATUS LABEL - Inter */
QLabel#statusLabel {
    color: #10b981;
    font-family: Inter;
    font-size: 13px;
    font-weight: 500;
    background: transparent;
    border: none;
}

QFrame#frame_status {
    background: rgba(255, 255, 255, 0.02);
    border-radius: 0 0 30px 30px;
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
}

QLabel#labelVersion {
    color: #f8d613;
    font-family: Inter;
    font-size: 12px;
    font-weight: 400;
    background: transparent;
    border: none;
}


QLabel#labelLocation, QLabel#labelTemp, QLabel#labelHumidity {
    color: rgba(255, 255, 255, 0.70);
    font-family: Inter;
    font-size: 15px;
    font-weight: 500;
    background: transparent;
    border: none;
}

QLabel#labelTemp:hover {
    color: #f8d613;
}

QScrollBar:vertical {
    background: rgba(255, 255, 255, 0.02);
    border: none;
    border-radius: 8px;
    width: 4px;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(248, 214, 19, 0.20);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
</string>
