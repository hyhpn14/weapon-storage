  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #0a1628,
        stop: 0.4 #142240,
        stop: 0.7 #1a2a4a,
        stop: 1 #0d1f3c
    );
}

QFrame#frame {
    background: rgba(255, 255, 255, 0.04);
    border-radius: 30px;
    border: none;
}

QFrame#frame_header {
    background: rgba(255, 255, 255, 0.02);
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

QLabel#labelTitle {
    color: #ffffff;
    font-family: Plus Jakarta Sans;
    font-size: 20px;
    font-weight: 700;
    background: transparent;
    border: none;
    letter-spacing: 2px;
}

QFrame#frame_stats {
    background: rgba(255, 255, 255, 0.02);
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}

QLabel { background: transparent; border: none; font-family: Inter; }
QLabel#statTotal { color: rgba(255,255,255,0.80); font-size: 12px; font-weight: 600; }
QLabel#statFilled { color: #10b981; font-size: 12px; font-weight: 600; }
QLabel#statEmpty { color: #3b82f6; font-size: 12px; font-weight: 600; }
QLabel#statAlert { color: #dc3545; font-size: 12px; font-weight: 600; }
QLabel#statPercent { color: #f8d613; font-size: 12px; font-weight: 700; }
QLabel#lbUser { color: #ffffff; font-size: 13px; font-weight: 600; }

QFrame#frame_grid {
    background: transparent;
    border: none;
}

QPushButton#btRefresh {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    color: rgba(255, 255, 255, 0.70);
    font-family: Inter;
    font-size: 13px;
    font-weight: 500;
    padding: 8px 20px;
    min-height: 20px;
}
QPushButton#btRefresh:hover {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.20);
}

QPushButton#btLogout {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
}
QPushButton#btLogout:hover {
    background: rgba(255, 70, 70, 0.15);
    border: 1px solid rgba(255, 70, 70, 0.30);
}

QFrame#frame_status {
    background: rgba(255, 255, 255, 0.02);
    border-radius: 0 0 30px 30px;
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
}

QLabel#statusLabel {
    color: #10b981;
    font-family: Inter;
    font-size: 12px;
    font-weight: 500;
    background: transparent;
    border: none;
}

QLabel#labelVersion {
    color: #f8d613;
    font-family: Inter;
    font-size: 11px;
    font-weight: 400;
    background: transparent;
    border: none;
}</string>
