  <property name="styleSheet">
   <string notr="true">   &lt;string notr=&quot;true&quot;&gt;
   /* ============================================================ */
/* GLASS THEME - SIGNALPRO GUN STORAGE SYSTEM                    */
/* ============================================================ */

/* Main Window - Dark Gradient Background */
QMainWindow {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 #0a1628,
        stop: 0.4 #142240,
        stop: 0.7 #1a2a4a,
        stop: 1 #0d1f3c
    );
}

/* ============================================================ */
/* GLASS CARD - FRAME UTAMA                                      */
/* ============================================================ */
QFrame#frame {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 40px;
    border: 1px solid rgba(255, 255, 255, 0.10);
}

/* ============================================================ */
/* FRAME TIME - JAM                                              */
/* ============================================================ */
QFrame#frame_3 {
    background: rgba(255, 255, 255, 0.03);
    border-radius: 24px 24px 0 0;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

/* Label Jam */
QLabel#lbTime {
    font-family: 'Orbitron';
    font-size: 90px;
    font-weight: 700;
    color: #ffffff;
    background: transparent;
    border: none;
    text-shadow: 0 0 30px rgba(74, 124, 247, 0.3);
    letter-spacing: 4px;
}

/* ============================================================ */
/* FRAME BOTTOM - LOGO &amp; DATE                                    */
/* ============================================================ */
QFrame#frame_5 {
    background: rgba(255, 255, 255, 0.03);
    border-radius: 0 0 24px 24px;
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
}

/* Logo Label */
QLabel#label {
    background: transparent;
    border: none;
}

/* Date Label */
QLabel#lbDate {
    font-family: 'Outfit';
    font-size: 16px;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.7);
    background: transparent;
    border: none;
    letter-spacing: 1px;
}

/* ============================================================ */
/* FRAME 2 - TOMBOL ENTER                                        */
/* ============================================================ */
QFrame#frame_2 {
    background: transparent;
    border: none;
}

/* Tombol Enter - Glass Style */
QPushButton#btDown {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(74, 124, 247, 0.25),
        stop: 1 rgba(108, 92, 231, 0.15)
    );
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 30px;
    qproperty-iconSize: 48px 48px;
}

QPushButton#btDown:hover {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(74, 124, 247, 0.40),
        stop: 1 rgba(108, 92, 231, 0.25)
    );
    border: 1px solid rgba(255, 255, 255, 0.30);
}

QPushButton#btDown:pressed {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(74, 124, 247, 0.10),
        stop: 1 rgba(108, 92, 231, 0.05)
    );
    border: 1px solid rgba(255, 255, 255, 0.05);
}

/* ============================================================ */
/* SCROLLBAR (Jika Ada)                                          */
/* ============================================================ */

QScrollBar:vertical {
    background: rgba(255, 255, 255, 0.03);
    border: none;
    border-radius: 8px;
    width: 4px;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.25);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}&lt;/string&gt;</string>
