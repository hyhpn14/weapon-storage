                     <property name="styleSheet">
                      <string notr="true">QLineEdit {
    background-color: #0d1226; /* Sedikit lebih gelap dari background utama */
    border: 2px solid #3d4a7d; /* Border dasar */
    border-radius: 8px;
    padding: 10px;
    color: #ffffff;
    font-family: 'Poppins';
    font-size: 14px;
}

/* Efek saat diklik/fokus */
QLineEdit:focus {
    border: 2px solid #FFF701; /* Garis kuning khas sistem Anda */
    background-color: #172147;
}

/* Jika Anda ingin menambahkan placeholder text yang cantik */
QLineEdit::placeholder {
    color: #556688;
}</string>
