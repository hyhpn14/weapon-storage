                     <property name="styleSheet">
                      <string notr="true">/* Style Dasar (Saat Tidak Dipilih) */
QPushButton {
    background-color: #172147; /* Warna gelap */
    color: #556688; /* Warna teks abu-abu */
    border: 2px solid #3d4a7d;
    border-radius: 15px;
    font-family: 'Orbitron';
	font-size : 15px;
    font-weight: bold;
    padding: 10px;
}

/* Style Saat Dipilih/Aktif */
QPushButton:checked {
    background-color: #FFF701; /* Kuning utama */
    color: #171835; /* Teks gelap */
    border: 2px solid #FFF701;
}

/* Efek Hover */
QPushButton:hover {
    border: 2px solid #FFF701;
    color: white;
}</string>
