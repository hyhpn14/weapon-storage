                     <property name="styleSheet">
                      <string notr="true">QComboBox {
     background-color: #0d1226; /* Sedikit lebih gelap dari background utama */
    border: 2px solid #3d4a7d; /* Border dasar */
    border-radius: 8px;
    padding: 10px;
    color: #ffffff;
    font-family: 'Poppins';
    font-size: 14px;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

/* Mengganti ikon panah agar sesuai warna */
QComboBox::down-arrow {
    image: url(C:/Users/programmer/Documents/06. Project 2026/08. Gun storage/scr/assets/down.png); /* Siapkan file ikon panah putih kecil */
    width: 15px;
    height: 15px;
}
/* Mengatur tampilan menu dropdown saat diklik */
QComboBox QAbstractItemView {
	background-color: #171835;
    color: white;
    selection-background-color: #FFF701; /* Warna kuning khas tombol Anda */
    selection-color: black;
    border: 1px solid #555555;
    outline: none;
}

</string>
